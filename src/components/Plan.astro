---
import Window from "@/components/Window.astro";
import { cavemen, contributors, org, repos, totalScore } from "@/lib/tribe";

const stars = repos.reduce((n, r) => n + r.stars, 0);
const forks = repos.reduce((n, r) => n + r.forks, 0);
---

<section class="section plan" id="plan">
  <div class="container">
    <div class="section__head">
      <span class="section__kicker">the whole business plan</span>
      <h2 class="section__title">three sentences. one working repo.</h2>
    </div>

    <div class="plan__grid">
      <div class="plan__col">
        <h3 class="plan__line" data-type="we eat bananas.">we eat bananas.</h3>
        <Window title="bananas.exe" icon="🍌" pad="0.75rem">
          <div class="panel banana" data-banana>
            <div
              class="banana__model"
              data-viewport
              data-kind="banana"
              data-login={org.login}
              data-avatar={org.avatar}
              data-size="256"
              data-zoom="0.82"
              data-tilt="-0.35"
              data-angle="0"
              data-hide-sticker
              data-follow-overlay=".banana__bites"
              data-static
              role="img"
              aria-label="A side view of the Team Ooga Booga 3D banana"
            >
              <span class="banana__fallback" aria-hidden="true">🍌</span>
            </div>
            <svg class="banana__bites" viewBox="0 0 240 220" aria-hidden="true">
              <g fill="#000">
                <path class="banana__bite" d="M240 0v220h-50v-51c-12-1-15-11-4-16-12-5-10-16 2-18-9-8-3-17 8-14h44z" />
                <path class="banana__bite" d="M240 0v220H135v-43c-13 0-17-11-5-18-13-4-12-16 1-20-10-8-4-18 8-17-7-10 1-19 13-14h88z" />
                <path class="banana__bite" d="M240 0v220H58v-67c0-15 5-29 22-37-14-5-11-18 7-20-14-8-7-22 9-20-12-11-3-25 15-21h129z" />
              </g>
            </svg>
            <img class="banana__fed" src="/img/caveman-fed.png" alt="A satisfied caveman surrounded by banana peels" width="512" height="512" />
            <p class="banana__caption" data-banana-caption>click to eat</p>
          </div>
          <dl class="stats">
            <div><dt>eaten by you</dt><dd data-banana-count>0</dd></div>
          </dl>
          <p class="note">bananas are the mascot, not the scoreboard. contribution credit comes directly from GitHub.</p>
        </Window>
      </div>

      <div class="plan__col">
        <h3 class="plan__line" data-type="we make code.">we make code.</h3>
        <Window title="MS-DOS Prompt - clanker" icon="▮" pad="0.75rem">
          <div class="term" data-term>
            <pre class="term__out" data-term-out aria-live="polite"></pre>
            <span class="term__cursor" aria-hidden="true">_</span>
            <noscript><pre class="term__out">C:\TRIBE&gt; ooga booga make bitcoin tool
[clanker] grunt received. cooking...
[clanker] wrote entropylab.html (1 file, 0 deps, 100% vibes)
C:\TRIBE&gt; git push origin rock
[rock] merged. tribe fed.</pre></noscript>
          </div>
          <div class="term__bar">
            <button class="btn" type="button" data-term-replay>run again</button>
            <span class="note">prompting is grunting. a caveman can build.</span>
          </div>
        </Window>
      </div>

      <div class="plan__col">
        <h3 class="plan__line" data-type="we give code to tribe.">we give code to tribe.</h3>
        <Window title="Tribe Properties" icon="🦍" pad="0.75rem">
          <fieldset class="open">
            <legend>everything in the open</legend>
            <label class="check"><input type="checkbox" checked disabled /> team meetings, live on X Spaces</label>
            <label class="check"><input type="checkbox" checked disabled /> prompts, readable by anyone</label>
            <label class="check"><input type="checkbox" checked disabled /> GitHub work, credited per contributor</label>
            <label class="check"><input type="checkbox" checked disabled /> code review by engineers and clankers, in public</label>
            <label class="check"><input type="checkbox" checked disabled /> open entry. public review.</label>
          </fieldset>
          <dl class="stats stats--grid">
            <div><dt>cavemen</dt><dd>{cavemen.length}</dd></div>
            <div><dt>contributors</dt><dd>{contributors.length}</dd></div>
            <div><dt>caves</dt><dd>{repos.length}</dd></div>
            <div><dt>stars</dt><dd>{stars}</dd></div>
            <div><dt>forks</dt><dd>{forks}</dd></div>
            <div><dt>impact</dt><dd>{totalScore.toLocaleString("en-US")}</dd></div>
          </dl>
        </Window>
      </div>
    </div>
  </div>
</section>

<style>
  .plan__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(290px, 100%), 1fr));
    gap: var(--gap);
    align-items: start;
  }
  .plan__col {
    display: grid;
    gap: 0.9rem;
  }
  .plan__line {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    color: var(--banana);
    text-shadow: 2px 2px 0 var(--banana-shadow);
    min-height: 1.2em;
  }
  .plan__line.is-typing::after {
    content: "▌";
    animation: blink 700ms steps(2, start) infinite;
    color: var(--paper);
  }

  .banana {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    place-items: center;
    row-gap: 0.3rem;
    height: 260px;
    padding: 0.5rem;
    cursor: pointer;
    user-select: none;
  }
  .banana__model,
  .banana__bites {
    grid-row: 1;
    grid-column: 1;
    width: min(100%, 270px);
    height: 220px;
    max-height: 100%;
  }
  .banana__model {
    position: relative;
  }
  .banana__fallback {
    display: none;
    position: absolute;
    inset: 0;
    place-items: center;
    font-size: 6rem;
    line-height: 1;
  }
  .banana__model.no-webgl .banana__fallback {
    display: grid;
  }
  .banana__bites {
    position: relative;
    z-index: 6;
    pointer-events: none;
  }
  .banana__bite {
    opacity: 0;
  }
  .banana[data-bites="1"] .banana__bite:nth-child(1),
  .banana[data-bites="2"] .banana__bite:nth-child(2),
  .banana[data-bites="3"] .banana__bite:nth-child(3),
  .banana[data-bites="4"] .banana__bite:nth-child(4) {
    opacity: 1;
  }
  .banana__fed {
    display: none;
    grid-row: 1;
    grid-column: 1;
    width: min(100%, 220px);
    max-height: 100%;
    object-fit: contain;
    position: relative;
    z-index: 7;
  }
  .banana[data-bites="4"] .banana__model,
  .banana[data-bites="4"] .banana__bites,
  .banana.is-gone .banana__model,
  .banana.is-gone .banana__bites {
    display: none;
  }
  .banana[data-bites="4"] .banana__fed,
  .banana.is-gone .banana__fed {
    display: block;
  }
  .banana__caption {
    grid-row: 2;
    position: relative;
    z-index: 7;
    margin: 0;
    font-size: 0.85rem;
    color: #bdbdbd;
    text-align: center;
    white-space: nowrap;
  }
  .stats {
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.25rem;
  }
  .stats div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dotted var(--face-shadow);
    padding-bottom: 0.2rem;
  }
  .stats dt {
    color: #3a3a3a;
  }
  .stats dd {
    margin: 0;
    font-family: var(--mono);
    font-weight: 700;
  }
  .stats--grid {
    grid-template-columns: repeat(2, 1fr);
    column-gap: 1rem;
  }
  .note {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: #3a3a3a;
  }

  .term {
    position: relative;
    background: var(--ink);
    color: var(--lime);
    box-shadow: var(--field-in);
    padding: 0.75rem;
    min-height: 11.5em;
    font-family: var(--mono);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .term__out {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
    font: inherit;
  }
  .term__cursor {
    animation: blink 800ms steps(2, start) infinite;
  }
  .term__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .term__bar .note {
    margin: 0;
  }

  .open {
    margin: 0;
    padding: 0.62rem 0.85rem 0.85rem;
    border: 0;
    box-shadow: inset 1px 1px var(--face-shadow), inset -1px -1px var(--face-lighter), inset 2px 2px var(--face-lighter),
      inset -2px -2px var(--face-shadow);
    display: grid;
    gap: 0.48rem;
  }
  .open legend {
    margin-left: 0.45rem;
    padding: 0.05rem 0.55rem 0.12rem;
    background: var(--face);
    font-weight: 700;
    line-height: 1.1;
  }
  .open .check {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-items: start;
    gap: 0.65rem;
    line-height: 1.45;
  }
</style>

<script>
  import { sleep } from "@/lib/sleep";

  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // typewriter headings
  const lines = document.querySelectorAll<HTMLElement>("[data-type]");
  if (!reduced && lines.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          io.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const text = el.dataset.type ?? "";
          el.textContent = "";
          el.classList.add("is-typing");
          let i = 0;
          const tick = () => {
            el.textContent = text.slice(0, ++i);
            if (i < text.length) setTimeout(tick, 45 + Math.random() * 60);
            else setTimeout(() => el.classList.remove("is-typing"), 1200);
          };
          setTimeout(tick, 200);
        }
      },
      { threshold: 0.6 },
    );
    lines.forEach((l) => io.observe(l));
  }

  // banana
  const banana = document.querySelector<HTMLElement>("[data-banana]");
  if (banana) {
    const caption = banana.querySelector<HTMLElement>("[data-banana-caption]");
    const counter = document.querySelector<HTMLElement>("[data-banana-count]");
    const captions = ["nom.", "nom nom.", "nom nom nom.", "banana gone. tribe fed."];
    let bites = 0;
    let eaten = 0;

    const resetBanana = () => {
      bites = 0;
      banana.dataset.bites = "0";
      banana.classList.remove("is-gone", "is-chomp");
      if (caption) caption.textContent = "click to eat";
    };

    banana.addEventListener("click", () => {
      if (bites >= 4) {
        resetBanana();
        return;
      }
      bites++;
      banana.dataset.bites = String(bites);
      banana.classList.remove("is-chomp");
      void banana.offsetWidth;
      banana.classList.add("is-chomp");
      if (caption) caption.textContent = captions[bites - 1];
      if (bites === 4) {
        eaten++;
        if (counter) counter.textContent = String(eaten);
        setTimeout(() => banana.classList.add("is-gone"), 260);
      }
    });
  }

  // terminal
  const term = document.querySelector<HTMLElement>("[data-term]");
  const out = term?.querySelector<HTMLElement>("[data-term-out]");
  if (term && out) {
    const script: Array<[string, number]> = [
      ["C:\\TRIBE> ", 0],
      ["ooga booga make bitcoin tool", 55],
      ["\n[clanker] grunt received. cooking", 0],
      ["...", 260],
      ["\n[clanker] wrote entropylab.html (1 file, 0 deps, 100% vibes)", 0],
      ["\nC:\\TRIBE> ", 0],
      ["git push origin rock", 55],
      ["\n[rock] merged. tribe fed.", 0],
    ];
    let run = 0;

    const play = async () => {
      const id = ++run;
      out.textContent = "";
      for (const [chunk, perChar] of script) {
        if (id !== run) return;
        if (!perChar || reduced) {
          out.textContent += chunk;
          await sleep(reduced ? 0 : 320);
          continue;
        }
        for (const ch of chunk) {
          if (id !== run) return;
          out.textContent += ch;
          await sleep(perChar + Math.random() * 40);
        }
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        play();
      },
      { threshold: 0.5 },
    );
    io.observe(term);
    document.querySelector("[data-term-replay]")?.addEventListener("click", play);
  }
</script>
