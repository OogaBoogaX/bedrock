---
interface Props {
  items: Array<string | { text: string; highlighted?: boolean }>;
  speed?: string;
  class?: string;
}
const { items, speed = "38s", class: className = "" } = Astro.props;
const textOf = (item: Props["items"][number]) => typeof item === "string" ? item : item.text;
---

<div
  class:list={["marquee", "ticker", className]}
  style={`--marquee-speed:${speed}`}
  role="marquee"
  aria-label={items.map(textOf).join(". ")}
  data-draggable-marquee
>
  <div class="marquee__track">
    {[0, 1].map((copy) => (
      <span class="marquee__group" aria-hidden={copy === 1 || undefined}>
        {items.map((item) => (
          <span class="ticker__item">
            {typeof item === "string" || !item.highlighted ? textOf(item) : <mark class="theme-update">{item.text}</mark>}
          </span>
        ))}
      </span>
    ))}
  </div>
</div>

<style>
  .ticker {
    background: var(--banana);
    color: var(--ink);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.35rem 0;
    box-shadow: inset 0 -2px 0 var(--banana-shadow);
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .ticker.is-dragging {
    cursor: grabbing;
  }
  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 3rem;
  }
  .ticker__item::after {
    content: "★";
    font-size: 0.7em;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-draggable-marquee]").forEach((marquee) => {
    if (marquee.dataset.dragReady === "true") return;
    marquee.dataset.dragReady = "true";

    const track = marquee.querySelector<HTMLElement>(".marquee__track");
    const group = track?.querySelector<HTMLElement>(".marquee__group");
    if (!track || !group) return;

    let pointerId = -1;
    let startX = 0;
    let startTime = 0;
    let animation: Animation | null = null;

    const marqueeAnimation = () =>
      track.getAnimations().find((candidate) => candidate instanceof CSSAnimation && candidate.animationName === "marquee") ?? null;

    const endDrag = (event: PointerEvent) => {
      if (event.pointerId !== pointerId) return;
      pointerId = -1;
      marquee.classList.remove("is-dragging");
      animation?.play();
      animation = null;
    };

    marquee.addEventListener("pointerdown", (event) => {
      if (event.button !== 0 || pointerId !== -1) return;
      animation = marqueeAnimation();
      if (!animation) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startTime = Number(animation.currentTime ?? 0);
      animation.pause();
      marquee.classList.add("is-dragging");
      marquee.setPointerCapture(event.pointerId);
      event.stopPropagation();
      event.preventDefault();
    });

    marquee.addEventListener("pointermove", (event) => {
      if (event.pointerId !== pointerId || !animation) return;
      const duration = Number(animation.effect?.getComputedTiming().duration ?? 0);
      const distance = group.getBoundingClientRect().width;
      if (duration <= 0 || distance <= 0) return;
      const draggedTime = ((event.clientX - startX) / distance) * duration;
      animation.currentTime = ((startTime - draggedTime) % duration + duration) % duration;
      event.preventDefault();
    });

    marquee.addEventListener("pointerup", endDrag);
    marquee.addEventListener("pointercancel", endDrag);
    marquee.addEventListener("lostpointercapture", endDrag);
  });
</script>
