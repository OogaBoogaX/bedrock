---
import { totalBananas } from "@/lib/tribe";
---

<div class="statusbar" aria-hidden="true">
  <span class="statusbar__cell statusbar__msg" data-status>Done</span>
  <span class="statusbar__cell statusbar__bananas">🍌 {totalBananas.toLocaleString("en-US")} bananas eaten</span>
  <span class="statusbar__cell statusbar__zone">
    <span class="statusbar__lock">🔒</span>
    <span>Internet zone</span>
  </span>
  <span class="statusbar__cell statusbar__clock" data-clock>--:--</span>
</div>

<style>
  .statusbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: flex;
    gap: 3px;
    height: 24px;
    padding: 2px 3px;
    background: var(--face);
    color: var(--ink);
    font-size: 0.78rem;
    line-height: 18px;
    box-shadow: inset 0 1px var(--face-lighter), 0 -1px var(--face-shadow);
    user-select: none;
  }
  .statusbar__cell {
    padding: 0 8px;
    box-shadow: var(--bevel-in);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .statusbar__msg {
    flex: 1;
  }
  .statusbar__zone {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .statusbar__lock {
    font-size: 0.7rem;
  }
  .statusbar__clock {
    font-family: var(--mono);
    min-width: 62px;
    text-align: center;
  }
  @media (max-width: 640px) {
    .statusbar__bananas,
    .statusbar__zone {
      display: none;
    }
  }
</style>
