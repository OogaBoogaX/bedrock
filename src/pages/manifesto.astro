---
import Base from "@/layouts/Base.astro";
import Window from "@/components/Window.astro";
import Footer from "@/components/Footer.astro";
import { manifesto } from "@/lib/manifesto";
import { members, repos, memberPath, avatarUrl, displayName } from "@/lib/tribe";

const { Content } = manifesto;
const lab = repos.find((r) => r.name === "entropylab") ?? repos[0];
const shareText = encodeURIComponent(`${manifesto.title}: ${manifesto.subtitle}. we eat bananas. we make code. we give code to tribe.`);
const share = `https://x.com/intent/post?text=${shareText}`;
const words = manifesto.words.toLocaleString("en-US");
---

<Base
  title={`${manifesto.title}: ${manifesto.subtitle} — Team Ooga Booga`}
  description={manifesto.description}
  ogImage="/og/manifesto.png"
  ogImageAlt={`${manifesto.title}: ${manifesto.subtitle}. The manifesto opened in a Windows 98 WordPad window.`}
>
  <div class="readbar" data-readbar aria-hidden="true"></div>
  <main class="post">
    <div class="container post__inner">
      <a class="post__back" href="/">← back to the cave</a>

      <header class="post__head">
        <span class="section__kicker">the manifesto</span>
        <h1 class="post__title"><span class="wordart">{manifesto.title.toLowerCase()}</span></h1>
        <p class="post__sub">{manifesto.subtitle}</p>
        <p class="post__meta">
          <span>
            by <a href={`https://x.com/${manifesto.authorHandle}`} rel="noopener me">@{manifesto.authorHandle}</a>
          </span>
          <span>{manifesto.dateLabel}</span>
          <span>{manifesto.minutes} min read</span>
          <span><del class="theme-replaced">0 degrees required</del>{" "}<mark class="theme-update">built in public</mark></span>
        </p>
      </header>

      <Window title="gorilla_open_source.doc - WordPad" icon="📄" class="wordpad" pad="0" active>
        <div class="wordpad__menu" aria-hidden="true">
          <span><u>F</u>ile</span><span><u>E</u>dit</span><span><u>V</u>iew</span><span><u>I</u>nsert</span><span>F<u>o</u>rmat</span><span><u>H</u>elp</span>
        </div>
        <div class="wordpad__tools" aria-hidden="true">
          <span class="wordpad__font field">Comic Sans MS</span>
          <span class="wordpad__size field">12</span>
          <span class="wordpad__tb"><b>B</b></span>
          <span class="wordpad__tb"><i>I</i></span>
          <span class="wordpad__tb"><u>U</u></span>
          <span class="wordpad__sep"></span>
          <span class="wordpad__tb is-on">☰</span>
          <span class="wordpad__tb">☰</span>
          <span class="wordpad__tb">☰</span>
          <span class="wordpad__sep"></span>
          <span class="wordpad__tb">🍌</span>
        </div>
        <div class="wordpad__ruler" aria-hidden="true"></div>
        <article class="doc" data-doc>
          <Content />
          <p class="signed">signed,</p>
          <ul class="signatures">
            {
              members.map((m) => (
                <li>
                  <a href={memberPath(m)}>
                    <img src={avatarUrl(m, 48)} width="24" height="24" alt="" loading="lazy" decoding="async" />
                    {displayName(m)}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="chant chant--end"><span class="wordart">Ooga booga.</span></p>
        </article>
        <div class="wordpad__status" aria-hidden="true">
          <span>For Help, press F1</span>
          <span data-read-text>0% read</span>
          <span>{words} words</span>
        </div>
      </Window>

      <div class="post__actions">
        <a class="btn btn--default btn--banana" href="/#tribe">meet the tribe</a>
        <a class="btn" href={share} rel="noopener" data-share data-status-text="Opens X with a pre-written grunt">share on X</a>
        <a class="btn" href={lab.url} rel="noopener">visit {lab.name}</a>
      </div>
    </div>
  </main>
  <Footer />

  <script>
    const doc = document.querySelector<HTMLElement>("[data-doc]");
    const bar = document.querySelector<HTMLElement>("[data-readbar]");
    const text = document.querySelector<HTMLElement>("[data-read-text]");
    if (doc && bar) {
      let queued = false;
      const update = () => {
        queued = false;
        const rect = doc.getBoundingClientRect();
        const total = rect.height - innerHeight;
        const done = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
        bar.style.setProperty("--read", done.toFixed(3));
        if (text) text.textContent = done >= 1 ? "100% read. tribe fed." : `${Math.round(done * 100)}% read`;
      };
      addEventListener(
        "scroll",
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );
      update();
    }

    const share = document.querySelector<HTMLAnchorElement>("[data-share]");
    if (share) {
      const url = new URL(share.href);
      url.searchParams.set("url", location.origin + location.pathname);
      share.href = url.toString();
    }
  </script>
</Base>

<style>
  .readbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: 4px;
    background: var(--banana);
    box-shadow: 0 1px 0 var(--banana-shadow);
    transform: scaleX(var(--read, 0));
    transform-origin: left;
  }
  .post {
    padding: clamp(1.5rem, 4vw, 3rem) 0 3rem;
  }
  .post__inner {
    max-width: 780px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  .post__back {
    justify-self: start;
    font-size: 0.9rem;
  }
  .post__head {
    text-align: center;
    padding-block: 0.5rem 1rem;
  }
  .post__title {
    margin: 0.5rem 0 1rem;
    font-size: clamp(2.4rem, 7vw, 4.2rem);
  }
  .post__sub {
    margin: 0 auto 0.75rem;
    max-width: 30ch;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 700;
    line-height: 1.3;
  }
  .post__meta {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: #bdbdbd;
  }
  .post__meta span + span::before {
    content: " · ";
    color: var(--face-shadow);
  }

  /* WordPad chrome */
  .wordpad__menu {
    display: flex;
    gap: 1rem;
    padding: 2px 8px;
    font-size: 0.85rem;
  }
  .wordpad__tools {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 6px;
    border-top: 1px solid var(--face-lighter);
    border-bottom: 1px solid var(--face-shadow);
    box-shadow: 0 1px var(--face-lighter);
    font-size: 0.8rem;
    overflow: hidden;
  }
  .wordpad__font,
  .wordpad__size {
    padding: 0.1rem 0.4rem;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .wordpad__font {
    width: 150px;
  }
  .wordpad__size {
    width: 44px;
  }
  .wordpad__tb {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    box-shadow: var(--bevel-out);
    font-size: 0.8rem;
  }
  .wordpad__tb.is-on {
    background: var(--face-light);
    box-shadow: var(--bevel-in);
  }
  .wordpad__sep {
    width: 2px;
    height: 18px;
    margin: 0 3px;
    box-shadow: inset 1px 0 var(--face-shadow), inset -1px 0 var(--face-lighter);
  }
  .wordpad__ruler {
    height: 18px;
    margin: 4px 3px 0;
    background:
      repeating-linear-gradient(90deg, var(--ink) 0 1px, transparent 1px 64px) 0 100% / 100% 8px no-repeat,
      repeating-linear-gradient(90deg, var(--face-shadow) 0 1px, transparent 1px 16px) 0 100% / 100% 4px no-repeat,
      var(--paper);
    box-shadow: var(--field-in);
  }
  .wordpad__status {
    display: flex;
    gap: 4px;
    padding: 4px 3px 1px;
    font-size: 0.8rem;
  }
  .wordpad__status span {
    flex: 1;
    padding: 1px 6px;
    box-shadow: var(--bevel-in);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .wordpad__status span:first-child {
    flex: 2;
  }

  /* The paper */
  .doc {
    margin: 3px;
    padding: clamp(1.25rem, 4vw, 3rem) clamp(1rem, 5vw, 3.5rem);
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--field-in);
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .doc :global(p) {
    margin: 0 0 1.25em;
  }
  .doc > :global(p:first-child)::first-letter {
    float: left;
    margin: 0.12em 0.35em 0 0;
    padding: 0.05em 0.2em 0;
    background: var(--banana);
    box-shadow: 2px 2px 0 var(--banana-shadow);
    font-size: 3.4em;
    line-height: 0.9;
    font-weight: 700;
  }
  .doc :global(h2) {
    display: table;
    margin: 2.2em 0 0.8em;
    padding-bottom: 0.1em;
    border-bottom: 4px solid var(--banana);
    font-size: clamp(1.35rem, 3vw, 1.65rem);
    line-height: 1.2;
  }
  .doc :global(h2:target) {
    background: var(--banana);
  }

  /* Pasted screenshots, framed as windows */
  .doc :global(.shot) {
    margin: 2rem 0 2.25rem;
    font-size: 0.85rem;
  }
  .doc :global(.shot--tall) {
    max-width: 520px;
    margin-inline: auto;
  }
  .doc :global(.shot img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .doc :global(.shot figcaption) {
    padding: 0.4rem 0.5rem;
    border-top: 1px solid var(--face-shadow);
    box-shadow: inset 0 1px var(--face-lighter);
    font-size: 0.8rem;
    color: #3a3a3a;
  }

  /* Pull quote as a message box */
  .doc :global(.msgbox) {
    max-width: 440px;
    margin: 1.75rem auto 2.25rem;
  }
  .doc :global(.msgbox__text) {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    margin: 0 0 0.9rem;
    font-size: 1rem;
    line-height: 1.45;
  }
  .doc :global(.msgbox__i) {
    flex: none;
    width: 32px;
    height: 32px;
    border: 2px solid var(--title-a);
    border-radius: 50%;
    background: var(--paper);
    color: var(--title-a);
    font: italic 700 20px/28px "Times New Roman", Times, serif;
    text-align: center;
  }
  .doc :global(.msgbox__foot) {
    display: flex;
    justify-content: center;
  }

  /* The chant */
  .doc :global(.chant) {
    margin: 2.75rem 0 0;
    font-size: clamp(1.15rem, 2.5vw, 1.4rem);
    font-weight: 700;
    line-height: 1.4;
  }
  .doc :global(.chant--end) {
    margin: 1rem 0 0.5rem;
    font-size: clamp(2.2rem, 7vw, 3.4rem);
  }

  /* The tribe signs */
  .doc .signed {
    margin: 2rem 0 0.5rem;
    font-style: italic;
  }
  .signatures {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
  }
  .signatures a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.6rem 0.15rem 0.2rem;
    background: var(--face);
    box-shadow: var(--bevel-out);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }
  .signatures a:hover {
    background: var(--banana);
  }
  .signatures img {
    width: 24px;
    height: 24px;
    box-shadow: var(--field-in);
  }

  .post__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  @media (max-width: 480px) {
    .wordpad__font {
      display: none;
    }
    .doc {
      font-size: 1rem;
    }
  }
</style>
