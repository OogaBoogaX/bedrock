---
import "@/styles/global.css";
import StatusBar from "@/components/StatusBar.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  ogImage = "/og/home.png",
  ogImageAlt = "Team Ooga Booga: gorilla open source. A WordArt title over the evolution strip in a Windows 98 Paint window.",
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content="Notepad.exe (allegedly)" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M6 4l4 2c-1 8 3 16 11 19l-2 4C8 26 2 14 6 4z' fill='%23ffe135' stroke='%23000' stroke-width='2' stroke-linejoin='round'/%3E%3C/svg%3E"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Team Ooga Booga" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body>
    <slot />
    <StatusBar />
    <script>
      import { initWindows } from "@/scripts/windows";
      import { initSparkles } from "@/scripts/sparkles";
      import { initStatusBar } from "@/scripts/statusbar";
      initWindows();
      initSparkles();
      initStatusBar();
    </script>
  </body>
</html>
