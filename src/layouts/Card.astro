---
// Fixed 1200×630 canvas for link-preview cards. Rendered to PNG by scripts/og.mjs.
import "@/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body class="card">
    <slot />
  </body>
</html>

<style is:global>
  html,
  body.card {
    width: 1200px;
    height: 630px;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    cursor: auto;
  }
  body.card::after {
    display: none;
  }
  .card__kicker {
    margin: 0;
    font-family: var(--mono);
    font-size: 20px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--banana);
  }
</style>
